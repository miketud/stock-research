# Copy to .env for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# EDGAR User-Agent for the public SEC filing data API (backend/src/routes/sec.route.ts).
# SEC requires a descriptive User-Agent that can reach the operator; this is the
# default. Leave blank to use the built-in fallback.
SEC_USER_AGENT=Mozilla/5.0 (compatible; SEC EDGAR research; stock-research);

# >>> bootstrap:region env.injections owner=base v=1.0.0
# Reddit application-only OAuth. Create a confidential app and keep both values server-side.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-research/0.1 by your-reddit-username
# REDDIT_MENTIONS_STATE_PATH=./var/reddit-mentions-state.json
# <<< bootstrap:region env.injections
